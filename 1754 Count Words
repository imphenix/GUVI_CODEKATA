#include <stdio.h>
#include <string.h>
int main() {
 char str[1000];
 int i = 0, count = 0;
 int inWord = 0; // Flag: 0 means we are outside a word, 1 means inside
 
 scanf("%[^\n]", str);
 while(str[i] != '\0') {
 if(str[i] != ' ') {
 if(inWord == 0) {
count++;

inWord = 1; // Mark that we are now inside a word
 }
 }
 else {
 inWord = 0;
 }
 i++;
 }
 printf("%d", count);
 return 0;
}
